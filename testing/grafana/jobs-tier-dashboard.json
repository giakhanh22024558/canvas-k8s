  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "type": "row",
      "title": "System overview (live, refresh 5s)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Web replicas (ready)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "targets": [{
        "expr": "kube_deployment_status_replicas_available{namespace=\"canvas\",deployment=\"canvas-web\"}",
        "refId": "A",
        "instant": true
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 3}
          ]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Jobs replicas (ready)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "targets": [{
        "expr": "kube_deployment_status_replicas_available{namespace=\"canvas\",deployment=\"canvas-jobs\"}",
        "refId": "A",
        "instant": true
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 3}
          ]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Pending jobs (queue depth)",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT count(*)::int AS pending FROM delayed_jobs WHERE locked_at IS NULL AND failed_at IS NULL",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 50},
            {"color": "red", "value": 200}
          ]},
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Oldest pending age (sec)",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM (now() - min(run_at))), 0)::int AS age_sec FROM delayed_jobs WHERE locked_at IS NULL AND failed_at IS NULL AND run_at <= now()",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 5},
            {"color": "red", "value": 10}
          ]},
          "unit": "s"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "row",
      "title": "Web tier history (Prometheus)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP throughput (RPS) and error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "RPS",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(k6_http_req_failed_total{expected_response=\"false\"}[1m])) / clamp_min(sum(rate(k6_http_reqs_total[1m])), 0.01)",
          "legendFormat": "Error %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Web replicas vs CPU%",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"canvas\",deployment=\"canvas-web\"}",
          "legendFormat": "Web replicas",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"canvas\",pod=~\"canvas-web-.*\",container!=\"POD\",container!=\"\"}[1m])) / sum(kube_pod_container_resource_requests{namespace=\"canvas\",pod=~\"canvas-web-.*\",resource=\"cpu\"})",
          "legendFormat": "Web CPU %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "type": "row",
      "title": "Jobs tier history (Prometheus + Postgres live)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Jobs replicas over time",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 7,
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"canvas\",deployment=\"canvas-jobs\"}",
          "legendFormat": "Ready",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"canvas\",deployment=\"canvas-jobs\"}",
          "legendFormat": "Spec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "stepAfter", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Jobs CPU% (HPA target = 60%)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 8,
      "targets": [
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"canvas\",pod=~\"canvas-jobs-.*\",container!=\"POD\",container!=\"\"}[1m])) / sum(kube_pod_container_resource_requests{namespace=\"canvas\",pod=~\"canvas-jobs-.*\",resource=\"cpu\"})",
          "legendFormat": "Jobs CPU%",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 60}
          ]},
          "custom.thresholdsStyle": {"mode": "line"}
        }
      }
    },
    {
      "type": "row",
      "title": "Jobs queue live snapshot (Postgres)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Running jobs",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
      "id": 9,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT count(*)::int AS running FROM delayed_jobs WHERE locked_at IS NOT NULL AND failed_at IS NULL",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Failed jobs",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24},
      "id": 10,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT count(*)::int AS failed FROM delayed_jobs WHERE failed_at IS NOT NULL",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 1}
          ]}}
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Total processed (cumulative)",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24},
      "id": 11,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT COALESCE(n_tup_del, 0)::bigint AS processed FROM pg_stat_user_tables WHERE relname = 'delayed_jobs'",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}}
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      }
    },
    {
      "type": "stat",
      "title": "Jobs by priority (top 5)",
      "datasource": {"type": "postgres", "uid": "canvas-postgres"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 24},
      "id": 12,
      "targets": [{
        "format": "table",
        "rawSql": "SELECT priority::text AS priority, count(*)::int AS n FROM delayed_jobs WHERE locked_at IS NULL AND failed_at IS NULL GROUP BY priority ORDER BY n DESC LIMIT 5",
        "refId": "A"
      }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true}
      }
    }
  ],
