# Cluster snapshot captured immediately before load test starts.
# Used by post-run analysis to verify the run was performed under known state.
captured_at=2026-05-14T06:07:21+00:00
git_commit=eb57a37
node_count=1

# Resource requests/limits — DEPLOYMENT SPEC (what manifest declares)
web_cpu_request_spec=1100m
web_cpu_limit_spec=4
web_memory_request_spec=4400Mi
web_memory_limit_spec=8Gi
jobs_cpu_request_spec=325m
jobs_cpu_limit_spec=2
jobs_memory_request_spec=4Gi
jobs_memory_limit_spec=4Gi

# Resource requests/limits — LIVE POD (reflects kubectl set resources patches)
web_cpu_request=1100m
web_cpu_limit=4
web_memory_request=4400Mi
web_memory_limit=8Gi
jobs_cpu_request=325m
jobs_cpu_limit=2
jobs_memory_request=4Gi
jobs_memory_limit=4Gi

# Replica counts (spec vs running)
web_replicas_spec=1
web_replicas_ready=1
jobs_replicas_spec=1
jobs_replicas_ready=1

# HPA settings (empty if no HPA)
web_hpa_min=1
web_hpa_max=3
web_hpa_target_cpu_percent=80
jobs_hpa_min=1
jobs_hpa_max=2
jobs_hpa_target_cpu_percent=80

# VPA recommendation targets (empty if no VPA)
web_vpa_target_cpu=1311m
web_vpa_target_memory=4066212754
jobs_vpa_target_cpu=763m
jobs_vpa_target_memory=4066212754

# Restart counter baseline (subtract from final to get in-test event count)
web_restart_baseline=0
jobs_restart_baseline=0

# Test-runner environment
cooldown_seconds=
flush_redis_between_runs=false
seed_prefix=
base_url=http://canvas.io.vn
